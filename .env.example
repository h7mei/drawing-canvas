# Copy to .env and fill in — .env is gitignored. Vite bakes VITE_ vars into the bundle.
DRAW_API_KEY=dch_your_key_here
VITE_DRAW_API_KEY=dch_your_key_here
# On-machine Postgres where every workflow run is stored (runs + stages tables).
DATABASE_URL=postgres://ai@127.0.0.1:5433/drawing_canvas
# Optional: path to Hermes CLI (default: ~/.local/bin/hermes).
# HERMES_BIN=/path/to/hermes
